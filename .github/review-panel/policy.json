{
  "version": 1,
  "lanes": [
    {
      "provider": "claude",
      "id": "correctness-concurrency",
      "prompt": ".github/review-panel/prompts/claude-correctness-concurrency.md",
      "when": "always"
    },
    {
      "provider": "claude",
      "id": "security-abuse",
      "prompt": ".github/review-panel/prompts/claude-security-abuse.md",
      "when": "always"
    },
    {
      "provider": "codex",
      "id": "regression-tests",
      "prompt": ".github/review-panel/prompts/codex-regression-tests.md",
      "when": "always"
    },
    {
      "provider": "codex",
      "id": "architecture-portability",
      "prompt": ".github/review-panel/prompts/codex-architecture-portability.md",
      "when": "always"
    },
    {
      "provider": "codex",
      "id": "simplicity-consolidation",
      "prompt": ".github/review-panel/prompts/codex-simplicity-consolidation.md",
      "when": "always"
    },
    {
      "provider": "codex",
      "id": "artifact-output",
      "prompt": ".github/review-panel/prompts/codex-artifact-output.md",
      "when": "user_facing"
    }
  ],
  "user_facing_paths": [
    "README.md",
    "docs/**",
    "install.sh",
    "install.ps1",
    "bin/**",
    "claude_md_snippet.md",
    "cursor_rule_snippet.mdc",
    "src/latch/install/quickstart.py",
    "src/latch/pipeline/seed.py",
    "src/latch/install/doctor.py",
    "src/latch/mcp/mcp_server.py",
    "src/latch/hosts/*_sync.py",
    "src/latch/install/install_*.py",
    "src/latch/install/uninstall*.py",
    "tests/seed_report_review_fixtures.py"
  ],
  "artifact_recipes": [
    {
      "id": "seed-report",
      "paths": [
        "src/latch/pipeline/seed.py",
        "src/latch/evals/seed_report_evals.py",
        "tests/seed_report_review_fixtures.py",
        "tests/test_seed*.py"
      ],
      "command": [
        "python",
        "tests/seed_report_review_fixtures.py",
        "--out-dir",
        "{output_dir}/seed-report",
        "--llm",
        "no"
      ]
    },
    {
      "id": "agent-contract-footprint",
      "paths": [
        "claude_md_snippet.md",
        "cursor_rule_snippet.mdc",
        "src/latch/hosts/agents_md_sync.py",
        "src/latch/hosts/claude_md_sync.py",
        "src/latch/hosts/cursor_rules_sync.py",
        "src/latch/hosts/managed_doc_sync.py"
      ],
      "command": [
        "python",
        ".github/scripts/agent_contract_footprint.py",
        "--base",
        "{base_sha}"
      ]
    }
  ]
}
